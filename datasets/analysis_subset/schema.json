{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:x-planner:analysis-subset:item:v1",
  "title": "X-Planner analysis-subset item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "split",
    "instruction",
    "task",
    "source_dataset",
    "media",
    "analysis",
    "labels"
  ],
  "properties": {
    "schema_version": {"const": "xplanner_analysis_item_v1"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "split": {"const": "analysis"},
    "instruction": {"type": "string", "minLength": 1},
    "task": {"type": "string", "minLength": 1},
    "task_classes": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "source_dataset": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri"},
    "license": {"type": "string", "minLength": 1},
    "anchor_frame": {"type": "integer", "minimum": 0},
    "media": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["view", "path", "sha256"],
        "properties": {
          "view": {"type": "string", "minLength": 1},
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.).+"
          },
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "width": {"type": "integer", "minimum": 1},
          "height": {"type": "integer", "minimum": 1}
        }
      }
    },
    "labels": {
      "type": "object",
      "description": "Event labels used for the published coverage analysis."
    },
    "analysis": {
      "type": "object",
      "description": "Source, semantic, temporal, and complexity attributes used by the paper plots."
    }
  }
}
