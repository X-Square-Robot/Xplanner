# Copy to .env and fill only the values needed by your workflow.
# Never commit .env or credentials.

XPLANNER_DATASET_REPO=/path/to/xDataset
XPLANNER_ENV_ROOT=/path/to/xplanner-env
XPLANNER_PYTHON=python
XPLANNER_MODEL_PATH=/path/to/model
XPLANNER_EVALUATION_MANIFEST=/path/to/evaluation_holdout/manifest.jsonl
XPLANNER_EVALUATION_SHA256=
# JSON object mapping deployment-specific media roots to stable logical roots.
XPLANNER_PATH_ALIASES={}
# Optional JSON mapping used only when importing legacy catalog paths.
XPLANNER_LEGACY_ROOTS={}

XPLANNER_LABEL_ROOT=/path/to/labels
XPLANNER_PRIMARY_MEDIA_ROOT=/path/to/primary_media
XPLANNER_COLLECTION_ROOT=/path/to/collection
XPLANNER_OPEN_ACTION_ROOT=/path/to/open_action
XPLANNER_ROBODOJO_MEDIA_ROOT=/path/to/robodojo/media
XPLANNER_ROBODOJO_LABEL_ROOT=/path/to/robodojo/labels
XPLANNER_ROBODOJO_SPLIT=/path/to/robodojo/official_split.json
XPLANNER_TAKEOVER_ROOT=/path/to/takeover
XPLANNER_TAKEOVER_REVIEWED_ROOT=/path/to/takeover/reviewed
XPLANNER_TAKEOVER_SNAPSHOT_ID=reviewed-release

USE_WANDB=false
WANDB_PROJECT=x-planner
WANDB_ENTITY=
WANDB_BASE_URL=https://api.wandb.ai
WANDB_API_KEY=

OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
MODEL_VERSION=
